# Do not use deprecated Firebase database secrets/token generators.
# Supported auth methods are service account JSON or GOOGLE_APPLICATION_CREDENTIALS.

# Optional if using GOOGLE_APPLICATION_CREDENTIALS instead
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Optional if included in service account JSON
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional collection names
FIREBASE_JOURNEYS_COLLECTION=journeys
FIREBASE_JOURNEY_PEOPLE_COLLECTION=journey_people
